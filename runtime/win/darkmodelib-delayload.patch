+/* A delay-loaded import's slot holds the loader's thunk until the import is first called, and the
+ * loader hands its caller whatever the slot holds. Saving that thunk as the true function would make
+ * the hook call itself; the target DLL's export is the real function, before or after resolution.
+ * The module stays loaded for the life of the process, which is how long the saved pointer is used. */
+template <typename T>
+static auto GetDelayLoadTarget(const char* dllName, const char* fnName, std::uint16_t ord) noexcept -> T
+{
+	const HMODULE trueMod = ::LoadLibraryA(dllName);
+	if (trueMod == nullptr)
+	{
+		return nullptr;
+	}
+	return reinterpret_cast<T>(::GetProcAddress(trueMod, (ord != 0) ? MAKEINTRESOURCEA(ord) : fnName));
+}
