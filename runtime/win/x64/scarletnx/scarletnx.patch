+/* The guest function whose translated code is at host pc, for a sampler that sees where a thread runs: 1 with the
+   function's guest range and the offset into its host code; 0 for code that is no function's (the JIT's, a wrapper's,
+   or outside the module). The function a host pc belongs to is the last one whose code starts at or below it; translated
+   code is larger than the guest's, but a pc past a generous span of it is not that function's (a gap or other code) */
+int snx_recompiled_host_function(const struct snx_recompiled* m, uint64_t host, uint64_t* guest_start, uint64_t* guest_end,
+                                 uint64_t* offset)
+{
+    if (!m || !m->compiled_function_count) return 0;
+    const SnxCompiledFunction* best = NULL;
+    uint64_t best_code = 0;
+    for (size_t i = 0; i < m->compiled_function_count; ++i) {
+        const SnxCompiledFunction* f = &m->compiled_functions[i];
+        uint64_t code = (uint64_t)(uintptr_t)f->code;
+        if (!code || code > host) continue;
+        if (!best || code >= best_code) { best_code = code; best = f; }
+    }
+    if (!best || best->end <= best->start) return 0;
+    uint64_t span = (best->end - best->start) * 64 + 65536;
+    if (host - best_code >= span) return 0;
+    if (guest_start) *guest_start = best->start;
+    if (guest_end) *guest_end = best->end;
+    if (offset) *offset = host - best_code;
+    return 1;
+}
+
+/* What the dispatch table holds for guest pc, and whether that function was retired by a code change: 1 with its host
+   address and 1 in *stale; 0 when the slot is empty (the next call compiles the code there) */
+int snx_recompiled_function_state(const struct snx_recompiled* m, uint64_t pc, uint64_t* code, int* stale)
+{
+    if (code) *code = 0;
+    if (stale) *stale = 0;
+    if (!m || (pc & 3)) return 0;
+    uint64_t o = pc - m->code_lo;
+    if (o >= m->code_hi - m->code_lo) return 0;
+    GuestFn f = __atomic_load_n(&m->dispatch[o >> 2], __ATOMIC_ACQUIRE);
+    if (!f) return 0;
+    if (code) *code = (uint64_t)(uintptr_t)f;
+    if (stale) {
+        for (size_t i = 0; i < m->compiled_function_count; ++i) {
+            const SnxCompiledFunction* g = &m->compiled_functions[i];
+            if (g->entry < m->entry_count && m->entry_addresses[g->entry] == pc) {
+                *stale = m->stale[g->stale_index] != 0;
+                break;
+            }
+        }
+    }
+    return 1;
+}
+
+/* The invalidator's lines, when a caller asks for them (the driver's log): which functions it retired and which
+   dispatch slots it cleared, to tell a hook that went in and left a stale function reachable from one that did not */
+static void (*library_log_fn)(const char*);
+void snx_recompiler_set_log(void (*fn)(const char*)) { library_log_fn = fn; }
+static void library_log(const char* fmt, ...)
+{
+    if (!library_log_fn) return;
+    char text[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(text, sizeof(text), fmt, ap);
+    va_end(ap);
+    library_log_fn(text);
+}
+
 void snx_recompiled_set_fallback(struct snx_recompiled* m, GuestFn fallback) {
     __atomic_store_n(&m->fallback, fallback, __ATOMIC_RELEASE);
 }
