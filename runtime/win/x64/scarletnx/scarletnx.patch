+/* A function's unit weight: its instructions plus its basic blocks (leaders), which the LLVM backend spends time
+   on too; TL_X64_UNIT_WEIGHT=instructions measures the instruction count alone. */
+static int weight_leaders(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* mode = getenv("TL_X64_UNIT_WEIGHT");
+        on = mode && !strcmp(mode, "instructions") ? 0 : 1;
+    }
+    return on;
+}
+
+static size_t function_weight(const SnxFunction* f)
+{
+    return f->count + (weight_leaders() ? f->leader_count * 4 : 0);
+}
